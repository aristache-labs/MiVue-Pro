{
  "expo": {
    "name": "Laneory",
    "slug": "mivue-866-cli",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "laneory",
    "userInterfaceStyle": "automatic",
    "owner": "pateutz",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/70081a2a-e7ee-42f5-a599-900b9995a1c2",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.laneory.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Laneory uses the local network to connect directly to your dashcam and list or download recordings you choose.",
        "NSLocationWhenInUseUsageDescription": "Laneory needs When-In-Use location access only so iOS can reveal the Wi‑Fi network name (SSID) of the dashcam you are connected to. Coordinates are not collected or stored.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "package": "app.laneory.mobile",
      "permissions": [
        "ACCESS_WIFI_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "NEARBY_WIFI_DEVICES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./plugins/withLocalNetworkCleartext.js",
      "./plugins/withWifiSsidAccess.js",
      "./plugins/withBackgroundDownloadSpike.js",
      "expo-video",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "subtitle": "For Mio MiVue 866",
      "shortDescription": "Independent local dashcam library for compatible Mio MiVue cameras.",
      "eas": {
        "projectId": "70081a2a-e7ee-42f5-a599-900b9995a1c2"
      }
    }
  }
}
