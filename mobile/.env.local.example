# SideStore Local Signing Configuration
# Copy this to .env.local and fill in your credentials
# .env.local is excluded from Git and should never be committed

# Apple Developer Account (free account for sideloading)
APPLE_ID=
APPLE_PASSWORD=

# Certificate path (absolute or relative to mobile/)
SIDESTORE_CERT_PATH=
SIDESTORE_CERT_PASSWORD=

# Provisioning profile path
SIDESTORE_PROVISION_PATH=<path-to-your-provisioning-profile.mobileprovision>

# Local build output
SIDESTORE_BUILD_OUTPUT=