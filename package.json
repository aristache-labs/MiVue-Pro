{
  "name": "mivue-866-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Proof-of-concept CLI for read-only interoperability with Mio MiVue 866 dashcams",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react-native-webview": "^13.15.0"
  }
}
